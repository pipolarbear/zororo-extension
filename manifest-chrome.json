{
  "manifest_version": 3,
  "name": "ororo",
  "version": "@VERSION@",
  "description": "One-click downloader for ororo.tv shows and movies with auto-skip, subtitle selection, star ratings, and queue management.",
  "permissions": [
    "storage",
    "downloads",
    "alarms"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Zororo"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://ororo.tv/*"
      ],
      "js": [
        "src/theme-boot.js"
      ],
      "css": [
        "src/site-theme.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://ororo.tv/*"
      ],
      "js": [
        "src/i18n.js",
        "src/donate.js",
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ]
    },
    {
      "matches": [
        "https://www.imdb.com/title/*",
        "https://www.imdb.com/*/title/*"
      ],
      "js": [
        "src/i18n.js",
        "src/donate.js",
        "src/imdb.js"
      ],
      "css": [
        "src/content.css",
        "src/imdb.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/zoro.png"
      ],
      "matches": [
        "https://ororo.tv/*",
        "https://www.imdb.com/*"
      ]
    }
  ],
  "host_permissions": [
    "https://ororo.tv/*",
    "https://www.imdb.com/*",
    "https://v2.sg.media-imdb.com/*",
    "https://www.rottentomatoes.com/*",
    "https://docs.google.com/forms/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
