{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "zororo-telemetry",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "zororo.xmousse.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zororo-telemetry",
      "database_id": "9ff08a96-7259-4441-8f54-a2877811a8c2"
    }
  ],
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
